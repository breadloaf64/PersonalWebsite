---
interface Props {
	title: string
	description: string
	date: Date
	pageReference?: {
		id: string
	}
	url?: string
	image?: string
	categories?: string[]
	type: 'post' | 'link'
	slug: string
}

const {
	title,
	description,
	date,
	pageReference,
	url,
	image,
	categories,
	type,
	slug,
} = Astro.props

if (type === 'link' && pageReference === undefined && url === undefined)
	throw Error(
		`\nThe feed content with title '${title}' is a link type so it needs a pageReference or url`,
	)

const linkAddress =
	type === 'post' ? `/posts/${slug}/` : pageReference ? pageReference.id : url

const dateText = date.toLocaleDateString('en', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
})
---

<a href={linkAddress} class="card">
	{image && <img src={image} alt="" loading="lazy" />}
	<div class="content">
		<h2><b>{title}</b></h2>
		<p class="categories">
			{
				categories?.map((category, i) => (
					<span>{category + (i < categories.length - 1 ? ', ' : '')}</span>
				))
			}
		</p>
		<p>{description}</p>
		<time datetime={date.toISOString()}>
			{dateText}
		</time>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		transition: transform 0.15s ease;
	}

	a {
		color: black;
	}

	.content {
		height: 100%;
		padding: 10px;
	}

	.card:hover {
		transform: translateY(-4px);
		background-color: whitesmoke;
	}

	img {
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}
</style>
