---
import '../styles/passwordProtectedLink.css'

interface Props {
	label: string
	href: string
	passwordHash: string
}

const { label, href, passwordHash } = Astro.props
---

<button
	type="button"
	class="link-button"
	data-dialog-target="members-only-dialog"
>
	{label}
</button>

<dialog id="members-only-dialog" class="members-dialog">
	<form class="password-form">
		<p><strong>Members only</strong></p>
		<label for="members-password">Password</label>
		<input
			id="members-password"
			name="password"
			type="password"
			autocomplete="on"
		/>
		<p id="password-error" class="password-error" aria-live="polite"></p>
		<div class="dialog-actions">
			<button type="button" data-close-dialog>Cancel</button>
			<button type="submit">Enter</button>
		</div>
	</form>
</dialog>

<script is:inline define:vars={{ href, passwordHash }}>
	const dialog = document.getElementById('members-only-dialog')
	const form = dialog?.querySelector('.password-form')
	const passwordInput = document.getElementById('members-password')
	const errorBox = document.getElementById('password-error')
	const trigger = document.querySelector(
		'[data-dialog-target="members-only-dialog"]',
	)

	function easyHash(input) {
		let hash = 0
		for (let i = 0; i < input.length; i++) {
			const char = input.charCodeAt(i)
			hash = (hash << 5) - hash + char
			hash |= 0 // Convert to 32bit integer
		}
		return hash.toString()
	}

	if (dialog && form && trigger) {
		trigger.addEventListener('click', () => {
			errorBox.textContent = ''
			passwordInput.value = ''
			dialog.showModal()
		})

		form.addEventListener('submit', (event) => {
			event.preventDefault()
			console.log('easyHash: ' + easyHash(passwordInput.value))
			if (easyHash(passwordInput.value) === passwordHash) {
				dialog.close()
				window.location.href = href
			} else {
				errorBox.textContent =
					"Incorrect password. Hint: What is Laura's catchphrase?"
			}
		})

		dialog
			.querySelector('[data-close-dialog]')
			?.addEventListener('click', () => {
				dialog.close()
			})
	}
</script>
