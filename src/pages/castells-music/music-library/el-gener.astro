---
import '../../../styles/castellsMusic.css'

import { YouTube } from '@astro-community/astro-embed-youtube'
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Castells Music</title>
	</head>
	<body>
		<div class="column">
			<a href="../../#extended-library">← back</a>
			<h1>El Gener</h1>

			<p>
				El Gener is a lively tune often paired with El Febrer. These two are
				popular to play during a cercavila (music parade before a castells
				performance).
			</p>

			<YouTube id="14_hY-U4jl8" title="Gener" />
			<YouTube
				id="DNfYWSpuPY0"
				title="Gener - Febrer - Passi-ho bé (Ball conjunt) - 13/12/2020"
			/>

			<img
				src="/castells-music/sheet music/El Gener/El Gener (1st Gralla) [solfege].svg"
				alt="Sheet music for El Gener"
			/>

			<ul>
				<li>
					1st Gralla: <a
						href="/castells-music/sheet music/El Gener/El Gener (1st Gralla) [solfege].pdf"
						>pdf</a
					> |
					<a
						href="/castells-music/sheet music/El Gener/El Gener (1st Gralla) [solfege, diagrams].pdf"
						>pdf with finger diagrams</a
					>
				</li>
				<li>
					2nd Gralla: <a
						href="/castells-music/sheet music/El Gener/El Gener (2nd Gralla) [solfege].pdf"
						>pdf</a
					> |
					<a
						href="/castells-music/sheet music/El Gener/El Gener (2nd Gralla) [solfege, diagrams].pdf"
						>pdf with finger diagrams</a
					>
				</li>
			</ul>
		</div>
	</body>
</html>
