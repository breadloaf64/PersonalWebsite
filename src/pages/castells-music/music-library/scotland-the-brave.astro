					<a
						href="/castells-music/sheet music/Scotland the Brave/Scotland the Brave (2nd Gralla) [solfege, diagrams].pdf"
						>pdf with finger diagrams</a
					>
				</li>
				<li>
					timbal: <a
						href="/castells-music/sheet music/Scotland the Brave/Scotland the Brave (Timbal).pdf"
						>pdf</a
					>
				</li>
			</ul>
		</div>
